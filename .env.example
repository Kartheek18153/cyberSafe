# Copy to .env and fill in. Never commit .env.
# Where to obtain each value is documented in README.md.

# Provider label for responses (free-form, e.g. gsma-sandbox).
OG_PROVIDER=gsma-sandbox

# Auth flow: mock | simulation | bearer | client_credentials | ciba | auth_code | jwt_bearer
# Keep "mock" until you have real sandbox credentials. "bearer" uses a
# portal-issued token (below) with no token endpoint. "simulation" runs a
# stateful temporary-data double (volatile, for demos) with no network.
OG_AUTH_FLOW=mock

# From GSMA Open Gateway sandbox portal after creating an application:
# Sandbox: https://open-gateway.gsma.com/sandbox
OG_CLIENT_ID=
OG_CLIENT_SECRET=

# From the sandbox portal / provider onboarding. Copy VERBATIM, including the
# API version path from the spec server template {apiRoot}/sim-swap/vN
# (the portal shows the full base URL ending in /sim-swap/v1 or /sim-swap/v2 —
# use whichever version the provider actually deploys; default assumption v2).
# No value is assumed here — leave blank until you have the portal value.
OG_API_BASE_URL=

# Deployed CAMARA major version: v2 (default, v2.1.0) or v1 (v1.0.0).
# Change to v1 ONLY when the portal confirms it serves /sim-swap/v1.
OG_SIM_SWAP_API_VERSION=v2

# OAuth/OIDC endpoints from the provider (see portal "Credentials" / "Endpoints"):
OG_TOKEN_URL=
OG_BC_AUTHORIZE_URL=

# Portal-issued bearer access token for OG_AUTH_FLOW=bearer. Export locally ONLY:
#   $env:OG_SIM_SWAP_BEARER_TOKEN="<paste-here>"  (PowerShell, session-only), or
#   fill the line below in your local .env (gitignored, never committed).
# Leave blank until the portal issues one. Nothing here is ever printed or logged.
OG_SIM_SWAP_BEARER_TOKEN=

# Exact scope string(s) from the sandbox portal for SIM Swap.
# Providers differ; copy verbatim. Leave blank until you have the portal value.
OG_SIM_SWAP_SCOPE=

# HTTP timeouts + defaults.
# OG_DEFAULT_LOOKBACK_HOURS is this app's /check default (MVP risk window).
# The CAMARA CreateCheckSimSwap spec default when maxAge is omitted is 240;
# this app always sends maxAge explicitly, so the spec default never applies.
# Allowed range for both: 1..2400.
OG_TIMEOUT_SECONDS=10
OG_DEFAULT_LOOKBACK_HOURS=72
OG_MAX_LOOKBACK_HOURS=2400
OG_APP_NAME=cybersafe-sim-swap
